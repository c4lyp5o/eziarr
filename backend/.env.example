# Copy to backend/.env for local development (`bun run dev` loads it).
# In Docker, set these as container environment variables instead;
# .env files are never copied into the image.

# HTTP port for the API and UI.
PORT=5000

# Session signing key. Leave unset to have one generated and stored in the
# database on first start.
# JWT_SECRET=

# Set the password on first start and skip the one-time setup code
# (8+ characters; ignored once a password exists). Or point
# EZIARR_PASSWORD_FILE at a file holding it.
# EZIARR_PASSWORD=devpassword
# EZIARR_PASSWORD_FILE=

# Number of reverse proxies in front of Eziarr whose X-Forwarded-For entry
# is trusted for login rate limiting. 0 (unset) without a proxy.
# TRUST_PROXY=1

# Force the Secure flag on session cookies (true/false). Default: on when
# the request arrived over HTTPS.
# COOKIE_SECURE=

# Move the data directories (defaults: ../db, ../logs, ../downloads).
# EZIARR_DB_DIR=
# EZIARR_LOG_DIR=
# EZIARR_DOWNLOAD_DIR=

# development: serves the OpenAPI UI at /openapi and returns error details.
# Never set this in production.
# NODE_ENV=development
